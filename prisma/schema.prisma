// Vercenji Health platform: Release A schema.
// Scope: brand site, supplements and lifestyle shop, EMS equipment catalogue and enquiries,
// partner and franchise applications, customer accounts and the admin.
// Release B (EMS booking, water, meals, subscriptions) and C (membership, UAE store) add tables later.
//
// Conventions: money is stored as integer minor units (paise) with a currency code;
// card details are never stored (Razorpay hosted checkout, verified by signed webhook).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ───────────────────────────── Accounts and access ─────────────────────────────

enum UserKind {
  CUSTOMER
  STAFF
}

model User {
  id             String    @id @default(cuid())
  kind           UserKind  @default(CUSTOMER)
  email          String?   @unique
  phone          String?   @unique // E.164, e.g. +919800000000
  emailVerified  DateTime?
  phoneVerified  DateTime?
  name           String?
  passwordHash   String? // optional; OTP is the primary login
  totpSecret     String? // staff two-factor, encrypted at rest by the app
  isActive       Boolean   @default(true)
  marketingOptIn Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  roles                UserRole[]
  sessions             Session[]
  addresses            Address[]
  orders               Order[]
  wishlist             WishlistItem[]
  cart                 Cart?
  reviews              Review[]
  auditLogs            AuditLog[]
  assignedApplications PartnerApplication[] @relation("ApplicationAssignee")
}

model Role {
  id          String     @id @default(cuid())
  key         String     @unique // owner, admin, catalogue, orders, partnerships, content, support
  name        String
  permissions Json // string[] of permission keys, e.g. ["orders.read", "orders.refund"]
  users       UserRole[]
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Session {
  id        String   @id // random token hash, never the raw token
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.VarChar(255)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum OtpChannel {
  SMS
  EMAIL
}

model OtpChallenge {
  id        String     @id @default(cuid())
  channel   OtpChannel
  target    String // phone or email
  codeHash  String
  attempts  Int        @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([target, createdAt])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String? // Home, Office
  fullName   String
  phone      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  postalCode String   @db.VarChar(12)
  country    String   @default("IN") @db.Char(2)
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────────── Catalogue ─────────────────────────────

enum Vertical {
  NUTRITION
  EMS
  WATER
  FOOD
  LIFESTYLE
}

enum ProductStatus {
  DRAFT // visible to staff only
  PENDING_REVIEW // awaiting regulatory or owner sign-off
  ACTIVE
  ARCHIVED
}

model Category {
  id          String            @id @default(cuid())
  vertical    Vertical
  slug        String            @unique
  name        String
  description String?           @db.Text
  parentId    String?
  parent      Category?         @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[]        @relation("CategoryTree")
  sortOrder   Int               @default(0)
  seo         Json? // { title, description, ogImage }
  products    ProductCategory[]
}

model Product {
  id               String        @id @default(cuid())
  vertical         Vertical
  slug             String        @unique
  name             String
  subtitle         String?
  description      String?       @db.Text
  status           ProductStatus @default(DRAFT)
  // Supplements: every field below must come from the approved label. Nothing is invented.
  ingredients      String?       @db.Text
  directions       String?       @db.Text
  warnings         String?       @db.Text
  approvedClaims   Json? // string[]; only claims signed off by the regulatory adviser
  regulatoryInfo   Json? // { fssaiLicence, manufacturer, marketer, countryOfOrigin, ... }
  claimsApprovedBy String?
  claimsApprovedAt DateTime?
  // Lifestyle and equipment
  brand            String?
  specifications   Json? // key/value list from the supplier's documents
  warranty         String?       @db.Text
  sizeGuide        String?       @db.Text
  audience         Json? // ["men","women","boys","girls","unisex","family"]
  hsnCode          String?       @db.VarChar(10)
  gstRateBps       Int? // GST rate in basis points, e.g. 1800 = 18%
  seo              Json?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  categories ProductCategory[]
  variants   ProductVariant[]
  images     ProductImage[]
  reviews    Review[]

  @@index([vertical, status])
}

model ProductCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model ProductVariant {
  id            String          @id @default(cuid())
  productId     String
  sku           String          @unique
  name          String // e.g. "60 capsules", "M / Forest green"
  options       Json? // { size: "M", colour: "Forest green" }
  currency      String          @default("INR") @db.Char(3)
  mrpMinor      Int // MRP, inclusive of taxes, in paise
  priceMinor    Int // selling price in paise
  stock         Int             @default(0)
  lowStockAt    Int             @default(5)
  allowPreorder Boolean         @default(false)
  weightGrams   Int?
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  stockMoves    StockMovement[]

  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  path      String // relative to the uploads folder
  alt       String
  sortOrder Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

enum StockReason {
  PURCHASE_RECEIVED
  ORDER_PLACED
  ORDER_CANCELLED
  RETURN_RESTOCKED
  MANUAL_ADJUSTMENT
}

model StockMovement {
  id        String         @id @default(cuid())
  variantId String
  delta     Int
  reason    StockReason
  note      String?
  orderId   String?
  actorId   String?
  createdAt DateTime       @default(now())
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model Review {
  id          String       @id @default(cuid())
  productId   String
  userId      String
  orderItemId String       @unique // verified purchases only
  rating      Int // 1-5
  title       String?
  body        String?      @db.Text
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItem   OrderItem    @relation(fields: [orderItemId], references: [id])

  @@index([productId, status])
}

// ───────────────────────────── Cart, wishlist, orders ─────────────────────────────

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  guestKey  String?    @unique // signed cookie for guest carts
  updatedAt DateTime   @updatedAt
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
}

model WishlistItem {
  userId    String
  variantId String
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([userId, variantId])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
}

model Order {
  id              String        @id @default(cuid())
  number          String        @unique // human-friendly, e.g. VH-2027-000123
  userId          String?
  guestEmail      String?
  guestPhone      String?
  status          OrderStatus   @default(PENDING_PAYMENT)
  currency        String        @default("INR") @db.Char(3)
  subtotalMinor   Int
  discountMinor   Int           @default(0)
  shippingMinor   Int           @default(0)
  taxMinor        Int           @default(0) // GST portion included in prices, for invoices
  totalMinor      Int
  discountCodeId  String?
  shippingAddress Json // snapshot at time of order
  billingAddress  Json?
  gstinForInvoice String?       @db.VarChar(15)
  courier         String?
  trackingNumber  String?
  invoiceNumber   String?       @unique
  notes           String?       @db.Text
  placedAt        DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User?         @relation(fields: [userId], references: [id])
  discountCode    DiscountCode? @relation(fields: [discountCodeId], references: [id])
  items           OrderItem[]
  payments        Payment[]
  events          OrderEvent[]

  @@index([userId, placedAt])
  @@index([status, placedAt])
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  variantId      String
  productName    String // snapshot
  variantName    String // snapshot
  sku            String
  unitPriceMinor Int
  quantity       Int
  gstRateBps     Int?
  hsnCode        String?        @db.VarChar(10)
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  review         Review?

  @@index([orderId])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  actorId   String?
  createdAt DateTime    @default(now())
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String        @default("razorpay")
  providerOrderId   String        @unique
  providerPaymentId String?       @unique
  status            PaymentStatus @default(CREATED)
  amountMinor       Int
  currency          String        @db.Char(3)
  method            String? // upi, card, netbanking, wallet (from the gateway; never card numbers)
  rawEvent          Json? // last verified webhook payload
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  refunds           Refund[]
}

model Refund {
  id               String   @id @default(cuid())
  paymentId        String
  providerRefundId String?  @unique
  amountMinor      Int
  reason           String?
  status           String   @default("pending")
  actorId          String?
  createdAt        DateTime @default(now())
  payment          Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

// Webhook events are stored once by provider event id so retries are idempotent.
model WebhookEvent {
  id          String    @id // provider event id
  provider    String
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
}

enum DiscountType {
  PERCENT
  FIXED
}

model DiscountCode {
  id             String       @id @default(cuid())
  code           String       @unique
  type           DiscountType
  value          Int // percent (e.g. 10) or fixed amount in paise
  minOrderMinor  Int          @default(0)
  maxUses        Int?
  usedCount      Int          @default(0)
  perCustomerMax Int?         @default(1)
  verticals      Json? // restrict to verticals; null = all
  startsAt       DateTime?
  endsAt         DateTime?
  isActive       Boolean      @default(true)
  orders         Order[]
}

// ───────────────────────────── EMS equipment (catalogue + quotes) ─────────────────────────────
// Equipment itself is a Product with vertical = EMS; these hold quote and enquiry workflow.

enum EnquiryStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

model EquipmentEnquiry {
  id        String        @id @default(cuid())
  productId String?
  name      String
  company   String?
  email     String
  phone     String
  city      String?
  country   String        @default("IN") @db.Char(2)
  interest  String // purchase | programme-access
  message   String?       @db.Text
  status    EnquiryStatus @default(NEW)
  consentAt DateTime
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
}

// ───────────────────────────── Partner and franchise applications ─────────────────────────────

enum PartnerModel {
  WELLNESS_HUB
  HOME_DIET_NUTRITION
  WELLNESS_CORNER
  CLOUD_KITCHEN
  OTHER
}

enum ApplicationStatus {
  NEW
  UNDER_REVIEW
  INFO_REQUIRED
  MEETING_SCHEDULED
  APPROVED_FOR_DISCUSSION
  NOT_PROCEEDING
}

model PartnerApplication {
  id                   String                @id @default(cuid())
  reference            String                @unique // e.g. VP-2027-00042, shown to the applicant
  model                PartnerModel
  kitchenStructure     String? // cloud kitchen only: existing licensed, new independent, compact, regional, multi-location
  fullName             String
  companyName          String?
  email                String
  phone                String
  country              String                @db.Char(2)
  city                 String
  proposedLocation     String?
  experience           String?               @db.Text
  hasKitchen           Boolean?
  investmentRange      String? // a band chosen from a list, never free-form figures
  launchTimeline       String?
  proposal             String?               @db.Text
  comments             String?               @db.Text
  status               ApplicationStatus     @default(NEW)
  assigneeId           String?
  consentAt            DateTime
  privacyNoticeVersion String
  source               Json? // utm parameters
  retainUntil          DateTime // 24 months for applications that do not progress (decision 16)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  assignee             User?                 @relation("ApplicationAssignee", fields: [assigneeId], references: [id])
  documents            ApplicationDocument[]
  notes                ApplicationNote[]

  @@index([status, createdAt])
  @@index([model])
}

model ApplicationDocument {
  id            String             @id @default(cuid())
  applicationId String
  path          String // stored outside the public folder; served only to authorised staff
  originalName  String
  mimeType      String
  sizeBytes     Int
  sha256        String             @db.Char(64)
  createdAt     DateTime           @default(now())
  application   PartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model ApplicationNote {
  id            String             @id @default(cuid())
  applicationId String
  authorId      String
  body          String             @db.Text
  statusChange  ApplicationStatus?
  createdAt     DateTime           @default(now())
  application   PartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

// ───────────────────────────── Content, marketing, audit ─────────────────────────────

model ContentBlock {
  id        String   @id @default(cuid())
  key       String   @unique // e.g. home.hero, home.verticals, banner.topbar
  data      Json
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model PageSeo {
  path        String  @id // e.g. /nutrition
  title       String?
  description String? @db.Text
  ogImage     String?
  noindex     Boolean @default(false)
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  consentAt      DateTime
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  source         String?
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String // e.g. product.update, order.refund, application.status
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ipAddress  String?  @db.VarChar(45)
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}
