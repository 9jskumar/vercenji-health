# Copy to .env for local development. Never commit real values.
# Production values are set on the MilesWeb server, not in Git.
DATABASE_URL="mysql://vercenji:change-me@localhost:3306/vercenji"
SITE_URL="http://localhost:3000"
SESSION_SECRET="generate-a-long-random-string"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# 32 random bytes, base64. Encrypts staff two-factor secrets. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=""
# Where uploaded documents are stored. Must be outside the public web folder.
UPLOAD_DIR="./storage/uploads"
# Delivery charge in rupees for orders below the free-delivery level (owner to confirm the amount; 0 means no charge),
# and the subtotal in rupees from which delivery is free (owner confirmed ₹3,000).
SHIPPING_FLAT_RUPEES="0"
SHIPPING_FREE_ABOVE_RUPEES="3000"
