# Copy to .env for local development. Never commit real values.
# Production values are set on the MilesWeb server, not in Git.
DATABASE_URL="mysql://vercenji:change-me@localhost:3306/vercenji"
SITE_URL="http://localhost:3000"
SESSION_SECRET="generate-a-long-random-string"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# 32 random bytes, base64. Encrypts staff two-factor secrets. Generate: openssl rand -base64 32
APP_ENCRYPTION_KEY=""
# Where uploaded documents are stored. Must be outside the public web folder.
UPLOAD_DIR="./storage/uploads"
# Delivery charge in rupees for orders below the free-delivery level (owner to confirm the amount; 0 means no charge),
# and the subtotal in rupees from which delivery is free (owner confirmed ₹3,000).
SHIPPING_FLAT_RUPEES="0"
SHIPPING_FREE_ABOVE_RUPEES="3000"
# Outgoing email (customer sign-in codes, return alerts), through a mailbox made in cPanel → Email Accounts.
# Without these, customers cannot sign in on the live site. Locally, emails are printed to the console instead.
# Use the server name: its certificate is valid, mail.vercenji.com has none of its own.
SMTP_HOST="omega.herosite.pro"
SMTP_PORT="465"
SMTP_USER="noreply@vercenji.com"
SMTP_PASS=""
MAIL_FROM="Vercenji <noreply@vercenji.com>"
# UAE store (AED, paid through Stripe). Leave STRIPE_SECRET_KEY empty to keep the UAE store hidden.
# With sk_test_ keys the UAE store is visible only to staff signed in to the admin.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# UAE delivery charge in dirhams, and the subtotal in dirhams from which UAE delivery is free (0 means no charge).
SHIPPING_AE_FLAT_AED="0"
SHIPPING_AE_FREE_ABOVE_AED="0"
# The UAE company selling under the Vercenji brand, shown at UAE checkout and on UAE order confirmations.
UAE_COMPANY_NAME=""
UAE_TRADE_LICENCE=""
UAE_TRN=""
UAE_COMPANY_ADDRESS=""
# e.g. "2 to 4 working days"
UAE_DELIVERY_DAYS=""
